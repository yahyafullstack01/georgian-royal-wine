# Your email server (SMTP) — orders + contact form
# Get these from your email provider (Gmail, Outlook, cPanel/hosting, etc.)

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@grw-wine.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional: "From" address shown to customers (defaults to SMTP_USER)
SMTP_FROM=info@grw-wine.com
SMTP_FROM_NAME=Georgian Royal Wine

# Inbox that receives every reservation (orders) and contact messages — YOUR company email
NOTIFICATION_EMAIL=info@grw-wine.com
